+
+// MOTO_DIG_SM digits (+ '.') at (x, pages pg..pg+1); the 13 px glyph is shifted
+// onto the bottom of the 2-page span.  Returns the end x.
+static int MotoSmDigits(const char *s, int x, int pg)
+{
+	for (const char *p = s; *p && x < LCD_WIDTH - MOTO_DIG_SM_MAXW; p++) {
+		if (*p == '.') {
+			gFrameBuffer[pg + 1][x] |= 0xC0;
+			gFrameBuffer[pg + 1][x + 1] |= 0xC0;
+			x += 4;
+			continue;
+		}
+		if (*p < '0' || *p > '9') { x += 3; continue; }
+		const uint8_t *g = MOTO_DIG_SM[*p - '0'];
+		for (int c = 0; c < MOTO_DIG_SM_MAXW && x + c < LCD_WIDTH; c++) {
+			uint16_t col = (uint16_t)(g[c * 2] | (g[c * 2 + 1] << 8)) << 3;
+			gFrameBuffer[pg][x + c]     |= (uint8_t)col;
+			gFrameBuffer[pg + 1][x + c] |= (uint8_t)(col >> 8);
+		}
+		x += MOTO_DIG_SM_W[*p - '0'];
+	}
+	return x;
+}
+
+// The last two digits (100 Hz + 10 Hz) are drawn ~half height (MOTO_DIG_SM),
+// bottom-aligned with the 24 px band, so the fine-tuning digits are
+// visually de-emphasised.  s is "MMM.ddddd".
+static void MotoFreq(const char *s)     // digits centred across gFrameBuffer rows 1..3
+{
+	int n = (int)strlen(s);
+	int nbig = n;
+	if (n >= 4 && s[n - 1] >= '0' && s[n - 1] <= '9'
+	           && s[n - 2] >= '0' && s[n - 2] <= '9')
+		nbig = n - 2;
+
+	int w = 0;
+	for (int k = 0; k < nbig; k++) {
+		int i = MOTO_MAP(s[k]);
+		if (i >= 0) w += MOTO_DIG_W[i];
+	}
+	const int small_w = (n - nbig) * (MOTO_DIG_SM_MAXW + 1);
+	int x = (LCD_WIDTH - w - small_w) / 2;
+	if (x < 1) x = 1;
+
+	for (int k = 0; k < nbig && x < LCD_WIDTH - 2; k++) {
+		int i = MOTO_MAP(s[k]);
+		if (i < 0) continue;
+		int cw = MOTO_DIG_W[i] - 1;
+		if (cw > MOTO_DIG_MAXW) cw = MOTO_DIG_MAXW;
+		for (int c = 0; c < cw && x + c < LCD_WIDTH; c++) {
+			gFrameBuffer[1][x + c] |= MOTO_DIG[i][c * 3 + 0];
+			gFrameBuffer[2][x + c] |= MOTO_DIG[i][c * 3 + 1];
+			gFrameBuffer[3][x + c] |= MOTO_DIG[i][c * 3 + 2];
+		}
+		x += MOTO_DIG_W[i];
+	}
+
+	{
+		char t[4];
+		int j = 0;
+		for (int k = nbig; k < n && j < 3; k++) t[j++] = s[k];
+		t[j] = 0;
+		MotoSmDigits(t, x, 2);
+	}
+}
