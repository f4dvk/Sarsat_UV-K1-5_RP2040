+// header text in the 6 px HDR6 font, shifted 1 px down so the inverted bar
+// keeps a clean 1 px edge top AND bottom of the 8 px row
+static void HdrPut(const char *s, int x)
+{
+	for (const char *p = s; *p && x < LCD_WIDTH; p++) {
+		int i = (*p >= '0' && *p <= '9') ? *p - '0'
+		      : (*p >= 'A' && *p <= 'Z') ? *p - 'A' + 10
+		      : (*p == '+') ? 36 : (*p == '-') ? 37 : -1;
+		if (i < 0) { x += 3; continue; }
+		for (int c = 0; c < HDR6_W[i] && x < LCD_WIDTH; c++, x++)
+			gFrameBuffer[0][x] |= (uint8_t)(HDR6[i][c] << 1);
+		x++;
+	}
+}
+static int HdrW(const char *s)
+{
+	int w = 0;
+	for (const char *p = s; *p; p++) {
+		int i = (*p >= '0' && *p <= '9') ? *p - '0'
+		      : (*p >= 'A' && *p <= 'Z') ? *p - 'A' + 10
+		      : (*p == '+') ? 36 : (*p == '-') ? 37 : -1;
+		w += (i < 0) ? 3 : HDR6_W[i] + 1;
+	}
+	return w;
+}
