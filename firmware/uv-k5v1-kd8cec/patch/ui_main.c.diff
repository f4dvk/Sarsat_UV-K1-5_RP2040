+	else
+#endif
+	if (IS_MR_CHANNEL(sc)) sprintf(s, "MR %u", sc + 1);
+	else                   sprintf(s, "VFO %c", (char)('A' + actVFO));
+	HdrPut(s, 3);
+
+	HdrPut(tx ? "TX" : rx ? "RX" : "", 43);            // TX / RX  (fixed)
+
+	int floor_x;
+	{ static const char pw[] = "LMH";                  // power (fixed slot)
+	  s[0] = pw[v->OUTPUT_POWER % 3]; s[1] = 0; HdrPut(s, 60);
+	  floor_x = 60 + HdrW(s); }
+
+	// offset direction, CTCSS and reverse follow a moving cursor with a ~4 px
+	// gap between each (like the UV-K1 header), instead of fixed columns that
+	// left "+ CT" cramped against each other.
+	if (v->freq_config_RX.Frequency != v->freq_config_TX.Frequency) {
+		int d = v->TX_OFFSET_FREQUENCY_DIRECTION % 3;
+		const char *ds = d == 1 ? "+" : d == 2 ? "-" : "";
+		if (ds[0]) { int x = floor_x + 4; HdrPut(ds, x); floor_x = x + HdrW(ds); }
+	}
+	{
+		const bool tc = v->freq_config_TX.CodeType != CODE_TYPE_OFF;
+		const bool rc = v->freq_config_RX.CodeType != CODE_TYPE_OFF;
+		const char *ct = tc && rc ? "CT" : tc ? "T" : "";
+		if (ct[0]) { int x = floor_x + 4; HdrPut(ct, x); floor_x = x + HdrW(ct); }
+	}
+	if (v->FrequencyReverse) {
+		int x = floor_x + 4; HdrPut("R", x); floor_x = x + HdrW("R");
+	}
+
+	{
+		char hr[8];
+		sprintf(hr, "%s%s",
+			v->Modulation < MODULATION_UKNOWN ? gModulationStr[v->Modulation] : "",
+			v->CHANNEL_BANDWIDTH == BANDWIDTH_NARROW ? " N" : "");
+		int hx = LCD_WIDTH - 3 - HdrW(hr);
+		if (hx < floor_x + 4) hx = floor_x + 4;         // modulation, right-anchored
+		HdrPut(hr, hx);
+	}
+	for (unsigned int x = 0; x < LCD_WIDTH; x++)
+		gFrameBuffer[0][x] ^= 0xFF;
+	gFrameBuffer[0][0]   &= 0x7E;
+	gFrameBuffer[0][127] &= 0x7E;
+}
+
+// the other VFO: one 7 px line -- "A  145.52500  FM" (letter spaced from the
+// frequency), or "A M12 name" for a memory channel.
+static void MainIdleVfo(unsigned int idleVFO, int row)
+{
+	char s[24], nm[16];
+	const VFO_Info_t *v2 = &gEeprom.VfoInfo[idleVFO];
+	const uint8_t sc2    = gEeprom.ScreenChannel[idleVFO];
+	const uint32_t f2    = v2->pRX->Frequency;
+#ifdef ENABLE_APRS
+	if (sc2 == APRS_TX_CHANNEL) {
+		sprintf(s, "%c  APRS", (char)('A' + idleVFO));
+	} else
+#endif
+	if (IS_MR_CHANNEL(sc2)) {
+		SETTINGS_FetchChannelName(nm, sc2);
+		if (nm[0])
+			sprintf(s, "%c  M%u %s", (char)('A' + idleVFO), sc2 + 1, nm);
+		else
+			sprintf(s, "%c  M%u %lu.%03lu", (char)('A' + idleVFO), sc2 + 1,
+				(unsigned long)(f2 / 100000), (unsigned long)((f2 / 100) % 1000));
+	} else {
+		sprintf(s, "%c  %lu.%05lu  %s", (char)('A' + idleVFO),
+			(unsigned long)(f2 / 100000), (unsigned long)(f2 % 100000),
+			v2->Modulation < MODULATION_UKNOWN ? gModulationStr[v2->Modulation] : "");
+	}
+	s[20] = 0;
+	UI_PrintStringSmallNormal(s, 2, 0, row);
+}
