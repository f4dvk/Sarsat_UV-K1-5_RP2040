+/* Sarsat_UV-K1-5_RP2040: menu "DbmCal" -- correction dBm par bande
+ * (dBmCorrTable, ui/main.c), portee du firmware V3 (armel/uv-k1-k5v3-
+ * firmware-custom) qui expose deja ce reglage sous le meme nom, a cote
+ * de "AfInv". dBmCorrTable est ici un tableau[7] modifiable (etait const
+ * dans le KD8CEC 0.3q d'origine) ; persiste dans une zone EEPROM reservee
+ * par KD8CEC pour ses propres extensions (CEC_EEPROM_START1..+0xAF,
+ * ceccommon.h) mais jamais utilisee au-dela de son propre bloc de 8
+ * octets (+0..+7, "KD8CEC WORK" dans settings.c) -- +0x08 choisi pour
+ * rester bien distinct de ce bloc existant, qui est reecrit en entier
+ * (y compris ses octets 4..7, remis a 0xFF) a chaque sauvegarde des
+ * reglages generaux. */
+#define DBMCAL_EEPROM_ADDR   (CEC_EEPROM_START1 + 0x08)
+
+void writeDbmCorr(const int32_t value, const bool update_eeprom)
+{
+	const uint8_t band = gRxVfo->Band;
+	dBmCorrTable[band] = (int8_t)value;
+
+	if (update_eeprom)
+	{
+		uint8_t buf[8];
+		for (uint8_t i = 0; i < 7; i++)
+			buf[i] = (uint8_t)dBmCorrTable[i];
+		buf[7] = 0xFF;
+		EEPROM_WriteBuffer(DBMCAL_EEPROM_ADDR, buf);
+	}
+}
